WEBTOOL_PUBLIC_URL=https://gihren.example.com
WEBTOOL_ALLOWED_HOSTS=gihren.example.com
WEBTOOL_SECURE_COOKIE=true
WEBTOOL_SIGNUP_ENABLED=true

WEBTOOL_SMTP_HOST=smtp.example.com
WEBTOOL_SMTP_PORT=587
WEBTOOL_SMTP_USERNAME=your-smtp-user
WEBTOOL_SMTP_PASSWORD=your-smtp-password
WEBTOOL_SMTP_FROM="Gihren Webtool <no-reply@gihren.example.com>"
WEBTOOL_SMTP_USE_TLS=true
WEBTOOL_SMTP_USE_SSL=false